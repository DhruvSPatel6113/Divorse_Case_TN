  "exp_3_inferential": {
    "experiment": "Experiment 3: Statistical Inference",
    "test_1_sex_disparity": {
      "research_question": "Is recorded divorce status significantly associated with sex in Tamil Nadu?",
      "null_hypothesis": "H0: Divorced status proportion is independent of sex.",
      "alternative_hypothesis": "H1: Divorced status proportion differs significantly between males and females.",
      "sample_size": 37478685,
      "contingency_table": {
        "divorced_male": 17763,
        "married_male": 18390578,
        "divorced_female": 45185,
        "married_female": 19025159
      },
      "chi2_statistic": 11017.84,
      "degrees_of_freedom": 1,
      "p_value": 0.0,
      "odds_ratio_female_to_male": 2.459,
      "cramers_v": 0.0171,
      "interpretation": "Women in Tamil Nadu are statistically significantly more likely to be recorded as divorced (OR = 2.53, p < 1e-15). Reflects demographic patterns of higher male remarriage and reporting."
    },
    "test_2_rural_urban_comparison": {
      "research_question": "Does district-level divorce prevalence differ significantly between rural and urban areas?",
      "test_method": "Welch's Two-Sample t-test (unequal variances assumed)",
      "sample_size_districts": 31,
      "rural_mean_per_1000": 0.836,
      "urban_mean_per_1000": 1.013,
      "t_statistic": -2.456,
      "p_value": 0.01751435841968392,
      "cohens_d": 0.624,
      "interpretation": "Urban areas show higher average recorded divorce rates (1.01/1,000) than rural areas (0.84/1,000), statistically significant (p = 0.0175)."
    },
    "confidence_intervals_95": {
      "statewide_divorce_rate": {
        "estimate": 0.0008724960680987146,
        "wilson_ci_lower": 0.0008657097074142456,
        "wilson_ci_upper": 0.0008793355807327659
      },
      "statewide_separated_rate": {
        "estimate": 0.00552044900531595,
        "wilson_ci_lower": 0.005503378153358504,
        "wilson_ci_upper": 0.0055375725142637585
      }
    }
  },
